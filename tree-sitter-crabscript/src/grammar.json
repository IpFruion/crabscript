{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "crabscript",
  "rules": {
    "source_file": {
      "type": "CHOICE",
      "members": [
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_line"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_eoi"
        }
      ]
    },
    "_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_whitespace"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "_comment"
                    },
                    {
                      "type": "SYMBOL",
                      "name": "directive"
                    }
                  ]
                },
                {
                  "type": "SYMBOL",
                  "name": "_eoi"
                }
              ]
            },
            {
              "type": "PATTERN",
              "value": "[\\n\\r]+"
            }
          ]
        }
      ]
    },
    "directive": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "instruction"
        },
        {
          "type": "SYMBOL",
          "name": "label"
        },
        {
          "type": "SYMBOL",
          "name": "cond_if"
        },
        {
          "type": "SYMBOL",
          "name": "cond_while"
        }
      ]
    },
    "instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "label",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_instruction_label"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        },
        {
          "type": "FIELD",
          "name": "output",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_output"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        },
        {
          "type": "FIELD",
          "name": "cmd",
          "content": {
            "type": "SYMBOL",
            "name": "ident"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_arg_entry"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_whitespace"
          }
        }
      ]
    },
    "label": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_label"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_whitespace"
          }
        }
      ]
    },
    "cond_if": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "if"
        },
        {
          "type": "SYMBOL",
          "name": "_whitespace"
        },
        {
          "type": "SYMBOL",
          "name": "_condition"
        },
        {
          "type": "SYMBOL",
          "name": "_cond_body"
        }
      ]
    },
    "cond_while": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "while"
        },
        {
          "type": "SYMBOL",
          "name": "_whitespace"
        },
        {
          "type": "SYMBOL",
          "name": "_condition"
        },
        {
          "type": "SYMBOL",
          "name": "_cond_body"
        }
      ]
    },
    "cond_for": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "for"
        },
        {
          "type": "SYMBOL",
          "name": "_whitespace"
        },
        {
          "type": "SYMBOL",
          "name": "ident"
        },
        {
          "type": "STRING",
          "value": "in"
        },
        {
          "type": "SYMBOL",
          "name": "_condition"
        },
        {
          "type": "SYMBOL",
          "name": "_cond_body"
        }
      ]
    },
    "_condition": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "ident"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SYMBOL",
                "name": "_arg_entry"
              }
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "variable_arg"
        }
      ]
    },
    "_cond_body": {
      "type": "SEQ",
      "members": [
        {
          "type": "PATTERN",
          "value": "[\\n\\r]"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_line"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_whitespace"
          }
        },
        {
          "type": "STRING",
          "value": "end"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_whitespace"
          }
        }
      ]
    },
    "_arg_entry": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT1",
          "content": {
            "type": "SYMBOL",
            "name": "_whitespace"
          }
        },
        {
          "type": "FIELD",
          "name": "arg",
          "content": {
            "type": "SYMBOL",
            "name": "arg"
          }
        }
      ]
    },
    "arg": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "variable_arg"
        },
        {
          "type": "SYMBOL",
          "name": "_quoted_arg"
        },
        {
          "type": "SYMBOL",
          "name": "_normal_arg"
        }
      ]
    },
    "variable_arg": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "${"
        },
        {
          "type": "SYMBOL",
          "name": "ident"
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "_quoted_arg": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "PATTERN",
          "value": "(?:[^\"\\\\]|\\\\.)*"
        },
        {
          "type": "STRING",
          "value": "\""
        }
      ]
    },
    "_normal_arg": {
      "type": "REPEAT1",
      "content": {
        "type": "PATTERN",
        "value": "[^ \\t\\n]"
      }
    },
    "_output": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "ident"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_whitespace"
          }
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_whitespace"
          }
        }
      ]
    },
    "_label": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "SYMBOL",
          "name": "ident"
        }
      ]
    },
    "ident": {
      "type": "PATTERN",
      "value": "[a-zA-Z0-9_]+"
    },
    "_instruction_label": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_label"
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "SYMBOL",
            "name": "_whitespace"
          }
        }
      ]
    },
    "_comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "#"
        },
        {
          "type": "PATTERN",
          "value": "[^\\n]*"
        }
      ]
    },
    "_whitespace": {
      "type": "PATTERN",
      "value": "[ \\t]"
    },
    "_eoi": {
      "type": "PREC",
      "value": 2,
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "[\\n\\r]*"
          },
          {
            "type": "SYMBOL",
            "name": "_eof"
          }
        ]
      }
    },
    "_eof": {
      "type": "STRING",
      "value": "\u0000"
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": []
}
